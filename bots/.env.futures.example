# Quant Futures Bot Configuration
# Copy this file to .env.futures and fill in your credentials

# Exchange: binance, bybit, or okx
EXCHANGE=binance

# API credentials
API_KEY=your_api_key_here
API_SECRET=your_api_secret_here
API_PASSPHRASE=your_passphrase_here_for_okx

# Testnet mode (true for paper trading, false for live)
TESTNET=true

# Trading pairs (comma-separated)
SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT

# Candle timeframe: 1m, 5m, 15m, 1h, 4h
TIMEFRAME=1h

# Leverage (1-10)
LEVERAGE=3

# Max position size as % of equity (before Kelly adjustment)
MAX_POSITION_PCT=5.0

# Max drawdown % before circuit breaker halts trading
MAX_DRAWDOWN_PCT=10.0

# Max daily loss % before halting for the day
MAX_DAILY_LOSS_PCT=5.0

# Polling interval in seconds
POLL_INTERVAL=60

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
