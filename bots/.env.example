# TrueMarkets API Credentials
TM_API_KEY_ID=your-api-key-uuid-here
TM_PRIVATE_KEY_FILE=/path/to/your/private-key.pem

# Trading Configuration
BOT_QUOTE_ASSET=USD
BOT_ASSETS=BTC,ETH,SOL
BOT_POLL_INTERVAL=60

# Risk Management
BOT_MAX_POSITION_PCT=5.0
BOT_MAX_DAILY_LOSS_PCT=3.0

# Webhook (optional, for TradingView alerts)
BOT_PORT=5000
BOT_WEBHOOK_SECRET=your-secret-here
